# Copy this to scripts/.asc-api-key.env (gitignored) and fill in your values to
# let scripts/build-ios-testflight.sh sign + upload headlessly via an App Store
# Connect API key instead of the Xcode-signed-in Apple ID (which expires).
#
# Create the key: App Store Connect > Users and Access > Integrations >
# App Store Connect API > Team Keys. Role must be ADMIN (distribution cloud
# signing fails with Developer/App Manager keys). Download the .p8 ONCE into
# ~/.appstoreconnect/private_keys/ — Apple won't let you download it again.
#
# The .p8 is a secret: keep it out of git (it lives in ~/.appstoreconnect, and
# scripts/.asc-api-key.env is gitignored).
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
ASC_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8"
